# ============================================================
# Plantilla de variables de entorno para AgroMap BackEnd
# Copia este archivo como `.env` y completa con tus credenciales reales.
# NO subas el archivo `.env` real a sistemas de control de versiones.
# ============================================================

# ── Servidor y Base de Datos ────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=tu_usuario_db
DB_PASSWORD=tu_contraseña_db
DB_NAME=Agromap
PORT=3002
NODE_ENV=development

# ── Seguridad (JWT) ─────────────────────────────────────────
JWT_SECRET=tu_secreto_para_firmar_tokens_jwt
JWT_EXPIRES_IN=1h

# ── Correo Electrónico (SMTP) ───────────────────────────────
# 1. Activa verificación en 2 pasos en tu cuenta de Google
# 2. Genera una "Contraseña de aplicación" de 16 caracteres
# 3. Pégala en SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion_gmail
SMTP_FROM="AgroMap <tu_correo@gmail.com>"

# ── Inteligencia Artificial (Groq) ──────────────────────────
# API Key: https://console.groq.com/keys
GROQ_API_KEY=tu_api_key_de_groq
GROQ_MODEL=llama-3.3-70b-versatile

# ── Flujo de Auto-revisión de Productores (IA) ──────────────
AI_AUTO_REVIEW_ENABLED=true
AI_FALLBACK_NOTIFY_EMAIL=correo_de_respaldo_admin@gmail.com

# ── Almacenamiento de Imágenes (Cloudinary) ─────────────────
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
